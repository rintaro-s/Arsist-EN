      "code": "// ==== プレゼン録画 (samples/virtual/presentation-recorder) ====\n// PC の画面 (products/ScreenCast) を大きなスクリーンに映し、自分は VRM (character.embody) になって説明し、\n// 仮想カメラ \"Cam\" で撮って MP4 にする (quest-input の recorder)。doc/23。\n//\n//   スクリーン SlideScreen … http://<PC>/stream/slides を映す (UI の Image の source)\n//   モニター   Monitor     … カメラの映像を鏡にして映す (カメラのすぐ後ろ = 撮る範囲の外)\n//   カンペ     Notes       … http://<PC>/stream/notes\n//   手元の板   Setup       … PC のアドレス・録画・スライド送り。録画中は隠す (映り込まないように)\n//\n// コントローラー: A 次 / B 前 / X 録画開始・停止 / Y 一時停止・再開 / ≡ 手元の板\n//   左スティック = カメラの向き、右スティック上下 = ズーム、左グリップを握りながら左スティック = カメラを前後左右に、\n//   左グリップ + 右スティック上下 = カメラを上下に。\n//   スライド・モニター・カンペ・カメラは、コントローラーを向けてグリップでつかんで動かせる (quest-input の grab、reach: far)。\n//   つかんでいる手のスティック上下で奥へ / 手前へ。つかんでいる間はスティックでカメラを動かさない\n\nvar CAM = 'Cam';\nvar ME = 'Me';\nvar SETUP = 'Setup';\nvar DEFAULT_PORT = 8090;\nvar FOV = { now: 48, min: 24, max: 70 };\n// 発表者とスクリーンの真ん中。cameras.* は実行中の世界の座標 (x = 右) なので、IR の配置 (x = 左) の X を反転した値\nvar LOOK_AT = { x: 0.72, y: -0.1, z: 0.12 };\nvar CAM_HOME = null; // 起動したときのカメラの姿勢 (「カメラを戻す」で使う)\n\nvar setupShown = true;\nfunction showSetup(on) { setupShown = !!on; scene.setVisible(SETUP, setupShown); }\n\nfunction hasRecorder() { return typeof recorder !== 'undefined' && recorder; }\nfunction hasController() { return typeof controller !== 'undefined' && controller; }\n\n// ---- 知らせ (手元の板の下の 1 行。数秒で消える) ----\nvar messageTimer = null;\nfunction say(text) {\n  log('[presentation] ' + text);\n  store.set('ui.message', text);\n  if (messageTimer) clearTimeout(messageTimer);\n  messageTimer = setTimeout(function () { store.set('ui.message', ''); }, 6000);\n}\n\n// ---- PC のアドレス (端末に残す: project.storage.persist = [\"pc.address\"]) ----\nfunction pcAddress() { return String(store.get('pc.address') || ''); }\n\n// \"http://192.168.0.12:8090/stream/slides\" → \"192.168.0.12:8090\"。ポートが無ければ 8090\nfunction normalizeAddress(text) {\n  var s = String(text || '').trim().replace(/^https?:\\/\\//i, '').replace(/\\/.*$/, '');\n  if (!s) return '';\n  if (s.indexOf(':') < 0) s = s + ':' + DEFAULT_PORT;\n  return s;\n}\n\nstore.set('ui.pcDraft', pcAddress());\nui.on('pcKb:submit', function () {\n  var a = normalizeAddress(store.get('ui.pcDraft'));\n  store.set('ui.pcDraft', a);\n  store.set('pc.address', a); // 画像の url の {store:pc.address} が変わり、つなぎ直す\n  if (typeof storage !== 'undefined') storage.save();\n  say(a ? '接続先を ' + a + ' にしました' : '接続先を消しました');\n  if (a) checkPc();\n});\n\n// PC の ScreenCast が動いているか (/status)。スライド送りができるかも分かる\nfunction checkPc() {\n  var a = pcAddress();\n  if (!a) return;\n  api.request({ url: 'http://' + a + '/status', method: 'GET', responseType: 'json', timeout: 4 }, function (r) {\n    if (!r.ok || !r.json) { say('PC (' + a + ') に届きません。ScreenCast は動いていますか? (' + (r.status || r.error || '') + ')'); return; }\n    var names = [];\n    for (var i = 0; i < (r.json.streams || []).length; i++) names.push(r.json.streams[i].name);\n    say('PC につながりました: ' + names.join(', ') + (r.json.control ? '' : ' (この PC ではスライド送りができません)'));\n  });\n}\n\n// ---- スライド送り (PC で → ← などのキーを押す) ----\nfunction slide(action) {\n  var a = pcAddress();\n  if (!a) { say('先に PC のアドレスを入れてください'); return; }\n  api.request({ url: 'http://' + a + '/control', method: 'POST', json: { action: action }, responseType: 'json', timeout: 3 }, function (r) {\n    if (!r.ok) say('スライド送りができません: ' + ((r.json && r.json.error) || r.status || r.error));\n  });\n  if (hasController()) controller.vibrate(action === 'next' ? 'right' : 'left', 0.3, 0.04);\n}\n\n// ---- 録画 ----\nfunction recState() { return hasRecorder() ? String(recorder.state || 'idle') : 'unavailable'; }\n\nfunction startRecording() {\n  if (!hasRecorder()) { say('録画は Quest (quest-input 拡張機能) でだけ使えます'); return; }\n  showSetup(false); // 手元の板は写したくない\n  // ビットレート・保存先・最長は拡張機能の設定 (recorderBitrate / recorderFolder / recorderMaxMinutes)\n  recorder.start({ camera: CAM, audio: true, fps: 30 }, function (r) {\n    if (!r || !r.ok) {\n      showSetup(true);\n      say('録画を始められません: ' + (r && r.error));\n    }\n  });\n}\n\nfunction stopRecording() {\n  if (!hasRecorder()) return;\n  recorder.stop(function (r) {\n    showSetup(true);\n    if (r && r.ok) say('保存しました: Movies/Arsist/' + r.file + ' (' + Math.round(r.seconds || 0) + ' 秒)');\n    else say('保存できませんでした: ' + (r && r.error));\n  });\n}\n\nfunction toggleRecording() {\n  var s = recState();\n  if (s === 'idle') startRecording();\n  else if (s === 'recording' || s === 'paused') stopRecording();\n}\n\nfunction togglePause() {\n  var s = recState();\n  if (s === 'recording') recorder.pause();\n  else if (s === 'paused') recorder.resume();\n}\n\nui.on('quest-input:recorder:started', function () { say('録画しています'); });\nui.on('quest-input:recorder:stopped', function () { showSetup(true); });\nui.on('quest-input:recorder:error', function () { showSetup(true); say('録画が止まりました (ログを見てください)'); });\n\n// 録画の表示 (モニターと手元の板が rec.label を出す)\nfunction two(n) { return (n < 10 ? '0' : '') + n; }\nfunction clock(seconds) {\n  var s = Math.max(0, Math.floor(seconds || 0));\n  return two(Math.floor(s / 60)) + ':' + two(s % 60);\n}\nvar lastLabel = '';\nfunction refreshRecLabel() {\n  var s = recState();\n  var secs = Number(store.get('input.recorder.seconds') || 0);\n  var label;\n  if (s === 'recording') label = '● REC ' + clock(secs);\n  else if (s === 'paused') label = '❚❚ 一時停止 ' + clock(secs);\n  else if (s === 'starting') label = '… 準備中';\n  else if (s === 'stopping') label = '… 保存中';\n  else if (s === 'unavailable') label = '録画は Quest で';\n  else label = '■ 待機中';\n  if (label === lastLabel) return;\n  lastLabel = label;\n  store.set('rec.label', label);\n  var busy = s === 'recording' || s === 'paused';\n  ui.setText('recBtn', busy ? '■ 録画停止' : '● 録画開始');\n  ui.setText('recBtnM', busy ? '■ 録画停止' : '● 録画開始');\n}\nsetInterval(refreshRecLabel, 250);\nrefreshRecLabel();\n\n// ---- ボタン ----\nui.on('recBtn', toggleRecording);\nui.on('recBtnM', toggleRecording);\nui.on('prevBtn', function () { slide('prev'); });\nui.on('prevBtnM', function () { slide('prev'); });\nui.on('nextBtn', function () { slide('next'); });\nui.on('nextBtnM', function () { slide('next'); });\nui.on('calibBtn', function () { vrm.calibrate(ME); say('背を測り直しました (まっすぐ立って前を見ているとき)'); });\n\n// ---- コントローラー (quest-input) ----\nif (hasController()) {\n  controller.on('right.a.down', function () { slide('next'); });\n  controller.on('right.b.down', function () { slide('prev'); });\n  controller.on('left.x.down', toggleRecording);\n  controller.on('left.y.down', togglePause);\n  controller.on('left.menu.down', function () {\n    if (recState() === 'recording') return; // 録画中は出さない\n    showSetup(!setupShown);\n  });\n  setInterval(stickTick, 50);\n}\n\n// ---- カメラをスティックで動かす (20 回/秒) ----\nvar STICK = { dead: 0.2, turn: 60, move: 0.8, zoom: 25 }; // 度/秒・m/秒・度/秒 (いっぱいに倒したとき)\nvar camMoved = false;\nfunction axis(v) { return Math.abs(v) < STICK.dead ? 0 : (v - (v > 0 ? STICK.dead : -STICK.dead)) / (1 - STICK.dead); }\n// つかんでいる間 (板やカメラを遠くからつかんで動かしているとき) は、スティックでカメラを動かさない\nvar holding = { left: false, right: false };\nif (hasController()) {\n  controller.on('grab', function (e) { holding[e.hand] = true; });\n  controller.on('release', function (e) { holding[e.hand] = false; });\n}\nfunction stickTick() {\n  if (holding.left || holding.right) return;\n  var l = controller.stick('left') || { x: 0, y: 0 };\n  var r = controller.stick('right') || { x: 0, y: 0 };\n  var lx = axis(l.x), ly = axis(l.y), ry = axis(r.y);\n  if (!lx && !ly && !ry) {\n    if (camMoved) { camMoved = false; var q = cameras.getPose(CAM); if (q) say('カメラ  向き ' + Math.round(q.ry) + '°  ' + Math.round(-q.rx) + '°  画角 ' + Math.round(FOV.now) + '°'); }\n    return;\n  }\n  var dt = 0.05;\n  var p = cameras.getPose(CAM);\n  if (!p) return;\n  camMoved = true;\n  var grip = controller.isDown('left', 'grip');\n  if (grip) {\n    // 前後左右 (カメラの水平の向きを基準に)、右スティックで上下\n    var yaw = p.ry * Math.PI / 180;\n    var fwd = ly * STICK.move * dt, side = lx * STICK.move * dt;\n    p.x += Math.sin(yaw) * fwd + Math.cos(yaw) * side;\n    p.z += Math.cos(yaw) * fwd - Math.sin(yaw) * side;\n    p.y += ry * STICK.move * dt;\n  } else {\n    p.ry += lx * STICK.turn * dt;\n    var pitch = p.rx > 180 ? p.rx - 360 : p.rx;\n    p.rx = Math.max(-70, Math.min(70, pitch - ly * STICK.turn * dt));\n    if (ry) {\n      FOV.now = Math.max(FOV.min, Math.min(FOV.max, FOV.now - ry * STICK.zoom * dt));\n      cameras.setFov(CAM, FOV.now);\n    }\n  }\n  cameras.setPose(CAM, p.x, p.y, p.z, p.rx, p.ry, 0);\n}\n\nfunction resetCamera() {\n  if (!CAM_HOME) return;\n  cameras.setPose(CAM, CAM_HOME.x, CAM_HOME.y, CAM_HOME.z, CAM_HOME.rx, CAM_HOME.ry, 0);\n  FOV.now = CAM_HOME.fov || 48;\n  cameras.setFov(CAM, FOV.now);\n  say('カメラを最初の位置に戻しました');\n}\nui.on('camResetBtn', resetCamera);\n\n// ---- 起動 ----\ncameras.lookAt(CAM, LOOK_AT.x, LOOK_AT.y, LOOK_AT.z); // 置いた向きの丸めを直す\nCAM_HOME = cameras.getPose(CAM);\nvrm.embody(ME, true);\nif (pcAddress()) checkPc();\nelse say('PC で ScreenCast を起動し、そのアドレスを入れて Enter');\n",
      "enabled": true,
      "description": "PC の画面を映し、スライド送りと録画をする (ボタン・コントローラー)",
      "createdAt": "2026-10-25T12:00:00.000Z",
      "updatedAt": "2026-10-25T12:00:00.000Z"
    }
  ]
}