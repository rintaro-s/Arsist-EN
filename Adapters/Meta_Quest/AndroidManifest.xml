<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Quest VR アプリとして認識させる必須エントリ -->
    <!--
        入口とテーマについて:
        Arsist は Android の入口を **Activity** に固定している
        (ArsistBuildPipeline.UseClassicAndroidActivity)。Unity 6 の既定である GameActivity では
        ソフトキーボードが出ず、Quest のシステムキーボード オーバーレイも動かないため。
        入口とテーマは対で決まっていて、混ぜるとビルドが AAPT で落ちる:
          Activity      → com.unity3d.player.UnityPlayerActivity     + @style/UnityThemeSelector
          GameActivity  → com.unity3d.player.UnityPlayerGameActivity + @style/BaseUnityGameActivityTheme
        (Unity 同梱の PlaybackEngines/AndroidPlayer/Apk/UnityManifest.xml がこの対を示している。
         BaseUnityGameActivityTheme は GameActivity のときしか APK に入らないので、
         Activity なのに指定すると `resource style/BaseUnityGameActivityTheme not found` で落ちる。)
        application 側は全画面の素のテーマにしつつ、activity には UnityThemeSelector を明示する。
        マージ順に依存して Unity 側のテーマが落ちることがあるため、ここで固定する。
    -->
    <application
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
        android:usesCleartextTraffic="true"
        tools:replace="android:theme,android:usesCleartextTraffic">

        <activity
            android:name="com.unity3d.player.UnityPlayerActivity"
            android:theme="@style/UnityThemeSelector"
            android:configChanges="density|fontScale|keyboard|keyboardHidden|layoutDirection|locale|mnc|mcc|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|touchscreen"
            android:exported="true"
            android:hardwareAccelerated="false"
            android:launchMode="singleTask"
            android:resizeableActivity="false"
            android:screenOrientation="landscape">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- Quest が VR モードで起動するために必須 -->
                <category android:name="com.oculus.intent.category.VR" />
            </intent-filter>

            <!-- VR専用アプリとして認識させる -->
            <meta-data android:name="com.samsung.android.vr.application.mode" android:value="vr_only" />
            <!-- Unity の起動 Activity であることの目印 (Unity 同梱 UnityManifest.xml と同じ) -->
            <meta-data android:name="unityplayer.UnityActivity" android:value="true" />
        </activity>

        <!-- Meta XR SDK 必須メタデータ -->
        <meta-data android:name="com.oculus.supportedDevices" android:value="quest|quest2|questpro|quest3|quest3s" />
        <meta-data android:name="com.oculus.ossplash" android:value="false" />
        <meta-data android:name="com.oculus.handtracking.version" android:value="V2.0" />
        <meta-data android:name="com.oculus.handtracking.frequency" android:value="HIGH" />

    </application>

    <!-- 必須パーミッション -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="com.oculus.permission.HAND_TRACKING" />
    <uses-permission android:name="com.oculus.permission.EYE_TRACKING" />
    <uses-permission android:name="com.oculus.permission.USE_SCENE" />
    <uses-permission android:name="com.oculus.permission.BOUNDARY" />

    <!-- VR ヘッドトラッキング必須 -->
    <uses-feature android:name="android.hardware.vr.headtracking" android:required="true" android:version="1" />

</manifest>
